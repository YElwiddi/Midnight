MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1241479722}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: af6c11f0d531f4249801ea5c2de41bcb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableTrigger
  interactionPrompt: Read
  backgroundImage: {fileID: 21300000, guid: 5face2da520a6fa4fa8eff1c614aff70, type: 3}
  overrideBackgroundSize: 0
  backgroundSize: {x: 375, y: 500}
  fontOverride: {fileID: 11400000, guid: d8b60348e071a7047abbe1036bf5145d, type: 2}
  overrideAlignment: 0
  textAlignment: 257
  overrideMargins: 0
  textMargins: {x: 0, y: 0, z: 0, w: 0}
  overrideLineSpacing: 0
  lineSpacing: 0
  overrideFontSize: 1
  fontSize: 18
  overrideFontColor: 1
  fontColor: {r: 0, g: 0, b: 0, a: 1}
  pages:
  - "Excerpt from the Gravekeeper\u2019s Notes\nUnregistered visitors\n\nTwo sisters
    come to the gate, never on the same night. Neither has family buried here, and
    each will tell you the other cannot be trusted.\n\nOne of them is lying. She
    must never be let in."
  - 'You will know her by how she asks.


    The one who lies cannot cross the threshold
    on her own. She must be invited, and she knows it. She will ask you to invite
    her in, sweetly, and more than once.


    Never invite her.


    The gate camera
    has never once recorded her.'
  - "The other never asks for an invitation. She asks to be let inside, and what
    she offers is real.\n\nHer rites quiet the dead and steady the keeper\u2019s
    mind, but they thin the wards that keep the grave robbers out. Let her in only
    when your nerves need it more than the graveyard does."
  rightColumnPages: []
  overrideRightColumnMargin: 0
  rightColumnMargin: {x: 0, y: 0, z: 0, w: 0}
  keeperRemarks: []
  redPenPhrases:
  - Never invite her.
  fieldNoteId: 
  enableLowSanityOverride: 1
  lowSanityThreshold: 0.4
  lowSanityOverrides:
    overridePages: 1
    pages:
    - I should let her in
    overrideBackground: 0
    backgroundImage: {fileID: 0}
    fontOverride: {fileID: 11400000, guid: 759accaa4ac2581479aa673fda0ef5c9, type: 2}
    overrideAlignment: 0
    textAlignment: 257
    overrideMargins: 0
    textMargins: {x: 0, y: 0, z: 0, w: 0}
    overrideLineSpacing: 0
    lineSpacing: 0
    overrideFontSize: 1
    fontSize: 60
    overrideFontColor: 1
    fontColor: {r: 0.7924528, g: 0, b: 0, a: 1}
    enableShake: 1
    shakeIntensity: 3
    shakeSpeed: 25
