  m_Script: {fileID: 11500000, guid: af6c11f0d531f4249801ea5c2de41bcb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableTrigger
  interactionPrompt: Read
  backgroundImage: {fileID: 21300000, guid: 5face2da520a6fa4fa8eff1c614aff70, type: 3}
  overrideBackgroundSize: 0
  backgroundSize: {x: 375, y: 500}
  fontOverride: {fileID: 11400000, guid: d8b60348e071a7047abbe1036bf5145d, type: 2}
  overrideAlignment: 0
  textAlignment: 257
  overrideMargins: 0
  textMargins: {x: 0, y: 0, z: 0, w: 0}
  overrideLineSpacing: 0
  lineSpacing: 0
  overrideFontSize: 1
  fontSize: 18
  overrideFontColor: 1
  fontColor: {r: 0, g: 0, b: 0, a: 1}
  pages:
  - "Excerpt from the Gravekeeper\u2019s Notes\nAnderson family\n\n\nFamily members:\nAnthony
    Anderson, 41, Deceased\nDiane Anderson, 39, Deceased\nJames Anderson, 9, Deceased\nDerek
    Anderson, 10, Deceased\nLily Anderson, 6, Alive\n\nAnthony is interred within
    these grounds.\n\nCause of death: Burned to death in house fire\n\nTime of death:
    October 11, 1988, Tuesday 12:03 AM"
  - 'Anthony, Diane, and their two sons died in a house fire shortly after midnight.
    It was blamed on an electrical fault by the rear stairwell, though inspections
    found no prior faults. The victims were found together in an upstairs bedroom.
    One child survived, having exited the house before responders arrived, and was
    later placed into foster care.


    She would say only that her father told
    them to stay together. A lighter was found by the stairwell and dismissed. The
    case was closed as an accident.'
  rightColumnPages: []
  overrideRightColumnMargin: 0
  rightColumnMargin: {x: 0, y: 0, z: 0, w: 0}
  keeperRemarks:
  - Lily, the only survivor, went into foster care.
  redPenPhrases:
  - One child survived, having exited the house before responders arrived, and was
    later placed into foster care.
  fieldNoteId: 
  enableLowSanityOverride: 0
  lowSanityThreshold: 0.25
