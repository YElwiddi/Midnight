  m_Script: {fileID: 11500000, guid: af6c11f0d531f4249801ea5c2de41bcb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableTrigger
  interactionPrompt: Read
  backgroundImage: {fileID: 21300000, guid: 5face2da520a6fa4fa8eff1c614aff70, type: 3}
  overrideBackgroundSize: 0
  backgroundSize: {x: 375, y: 500}
  fontOverride: {fileID: 11400000, guid: d8b60348e071a7047abbe1036bf5145d, type: 2}
  overrideAlignment: 0
  textAlignment: 272
  overrideMargins: 0
  textMargins: {x: 0, y: 0, z: 0, w: 0}
  overrideLineSpacing: 0
  lineSpacing: 0
  overrideFontSize: 1
  fontSize: 18
  overrideFontColor: 1
  fontColor: {r: 0, g: 0, b: 0, a: 1}
  pages:
  - "Excerpt from the Gravekeeper\u2019s Notes\nHuang family\n\nFamily members:\nWenqi
    Huang, 73, Alive\nMei Huang, 70, Deceased\nChen Huang, 48, Alive\n\nMei Huang
    is interred within these grounds.\n\nCause of death: Lethal injection\n\nTime
    of death: March 27, 1993, Saturday 4:00 PM"
  - "Huang Wenqi chose the plot himself and brought the paperwork, repeating details
    already settled. No other family attended. When I asked whether the son would
    come, Wenqi said the family was complete as it stood, then paused.\n\nMei\u2019s
    death was recorded as a crime resolved, a matter of dishonor settled; no details
    were given. No offerings are permitted in the son\u2019s name. Wenqi visits alone
    now, repeating himself, always checking the stone before he leaves."
  rightColumnPages: []
  overrideRightColumnMargin: 0
  rightColumnMargin: {x: 0, y: 0, z: 0, w: 0}
  keeperRemarks:
  - Wenqi, the husband, visits alone. He repeats himself.
  - "No offerings are permitted in the son\u2019s name."
  redPenPhrases:
  - "No offerings are permitted in the son\u2019s name."
  - Wenqi said the family was complete as it stood
  fieldNoteId: 
  enableLowSanityOverride: 0
  lowSanityThreshold: 0.25
  lowSanityOverrides:
