  m_Script: {fileID: 11500000, guid: af6c11f0d531f4249801ea5c2de41bcb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableTrigger
  interactionPrompt: Read
  backgroundImage: {fileID: 21300000, guid: 5face2da520a6fa4fa8eff1c614aff70, type: 3}
  overrideBackgroundSize: 0
  backgroundSize: {x: 375, y: 500}
  fontOverride: {fileID: 11400000, guid: d8b60348e071a7047abbe1036bf5145d, type: 2}
  overrideAlignment: 0
  textAlignment: 257
  overrideMargins: 0
  textMargins: {x: 0, y: 0, z: 0, w: 0}
  overrideLineSpacing: 0
  lineSpacing: 0
  overrideFontSize: 1
  fontSize: 18
  overrideFontColor: 1
  fontColor: {r: 0, g: 0, b: 0, a: 1}
  pages:
  - "Excerpt from the Gravekeeper\u2019s Notes\nFather Joseph\n\nAbandoned some time
    ago, the church dates back to a time older than those that are buried here. Over
    centuries old, the church has recently been abandoned. A remark has been made
    about the coincedental timing of the abandonment of the church and the anamolous
    circumstances that have began since its abandonment."
  - 'On the last caretaker of the church and his disappearance:


    Father Joseph
    was once welcomed on these grounds; his presence brought peace. His denomination
    forbids its clergy to marry. He defied this, feuded with the ministry, and later
    denounced the clergy.


    He was to marry his betrothed but never appeared
    at the altar. She is said to have died of grief on learning his fate. That fate
    remains unknown.'
  rightColumnPages: []
  overrideRightColumnMargin: 0
  rightColumnMargin: {x: 0, y: 0, z: 0, w: 0}
  keeperRemarks: []
  redPenPhrases: []
  fieldNoteId: 
  enableLowSanityOverride: 0
  lowSanityThreshold: 0.4
  lowSanityOverrides:
    overridePages: 1
    pages:
    - I should let her in
    overrideBackground: 0
    backgroundImage: {fileID: 0}
    fontOverride: {fileID: 11400000, guid: 759accaa4ac2581479aa673fda0ef5c9, type: 2}
    overrideAlignment: 0
    textAlignment: 257
    overrideMargins: 0
    textMargins: {x: 0, y: 0, z: 0, w: 0}
    overrideLineSpacing: 0
    lineSpacing: 0
    overrideFontSize: 1
    fontSize: 60
    overrideFontColor: 1
    fontColor: {r: 0.7924528, g: 0, b: 0, a: 1}
    enableShake: 1
    shakeIntensity: 3
    shakeSpeed: 25
