  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableTrigger
  interactionPrompt: Read
  backgroundImage: {fileID: 21300000, guid: 5face2da520a6fa4fa8eff1c614aff70, type: 3}
  overrideBackgroundSize: 0
  backgroundSize: {x: 375, y: 500}
  fontOverride: {fileID: 11400000, guid: d8b60348e071a7047abbe1036bf5145d, type: 2}
  overrideAlignment: 0
  textAlignment: 257
  overrideMargins: 0
  textMargins: {x: 0, y: 0, z: 0, w: 0}
  overrideLineSpacing: 0
  lineSpacing: 0
  overrideFontSize: 1
  fontSize: 18
  overrideFontColor: 1
  fontColor: {r: 0, g: 0, b: 0, a: 1}
  pages:
  - "Excerpt from the Gravekeeper\u2019s Notes\nHolmes family\n\n\nFamily members:\nJason
    Holmes, 48, Alive\nZackary Holmes, 46, Deceased\nEdward Holmes, 17, Deceased\nElisabeth
    Holmes, 45, Alive\n\nEdward and Zackary are interred within these grounds.\n\nCause
    of death: Unknown; alleged accident\n\nTime of death: April 12, 1998, Sunday
    3:45 AM"
  - "Zackary and Edward Holmes were buried here after a reported single-car accident
    on the county road: the car found overturned beyond the tree line, engine still
    warm. Elisabeth was found nearby in shock and released without charge. The family
    declined any inquiry.\n\nIn the weeks before, the household kept odd hours and
    moved furniture out of the basement. Candles and ash were later found among Zackary
    and Edward\u2019s belongings. The car was barely damaged. Elisabeth never returned
    to these grounds after the burial."
  rightColumnPages: []
  overrideRightColumnMargin: 0
  rightColumnMargin: {x: 0, y: 0, z: 0, w: 0}
  keeperRemarks:
  - Elisabeth, the widow, never came back after the burial.
  redPenPhrases:
  - Elisabeth never returned to these grounds after the burial.
  fieldNoteId: 
  enableLowSanityOverride: 1
  lowSanityThreshold: 0.25
  lowSanityOverrides:
    overridePages: 1
    pages:
    - HE IS A LYING BASTARD DO NOT TRUST HIM
    overrideBackground: 0
    backgroundImage: {fileID: 0}
