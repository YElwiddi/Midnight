--- !u!114 &1580025103
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1580025102}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4a3a69ea66365fe46a76ea696e08ade8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroTextUI
  pages:
  - text: The last gravekeeper left without a word.
    font: {fileID: 11400000, guid: d8b60348e071a7047abbe1036bf5145d, type: 2}
    fontSize: 48
    textColor: {r: 0.9811321, g: 0.9811321, b: 0.9811321, a: 1}
    image: {fileID: 0}
    minimumDisplayTime: 0
  - text: Don't know why he left, but the job opened up, and I desperately needed
      cash.
    font: {fileID: 11400000, guid: d8b60348e071a7047abbe1036bf5145d, type: 2}
    fontSize: 48
    textColor: {r: 1, g: 1, b: 1, a: 1}
    image: {fileID: 0}
    minimumDisplayTime: 0
  - text: It's just a grave watching job. Shouldn't be too difficult. Just keeping
      younger folks and gangs away from the place. It's pretty barren out here.
    font: {fileID: 11400000, guid: d8b60348e071a7047abbe1036bf5145d, type: 2}
    fontSize: 48
    textColor: {r: 1, g: 1, b: 1, a: 1}
    image: {fileID: 0}
    minimumDisplayTime: 0
  - text: September 17, 1999.
    font: {fileID: 11400000, guid: d8b60348e071a7047abbe1036bf5145d, type: 2}
    fontSize: 48
    textColor: {r: 1, g: 1, b: 1, a: 1}
    image: {fileID: 0}
    minimumDisplayTime: 0
  - text: 
    font: {fileID: 0}
    fontSize: 48
    textColor: {r: 1, g: 1, b: 1, a: 1}
    image: {fileID: 21300000, guid: 8a56a59210eece140b280ab8339dcf39, type: 3}
    minimumDisplayTime: 0
  canvas: {fileID: 0}
  canvasGroup: {fileID: 0}
  mainText: {fileID: 0}
  continuePrompt: {fileID: 0}
  continueText: Click to continue...
  continueFont: {fileID: 0}
  continueFontSize: 20
  continueColor: {r: 0.6, g: 0.6, b: 0.6, a: 1}
