?","\n","^Shane Deloitte.","\n",{"->":"more_questions"},{"#f":1}],"let_in":["^Thank you.","\n","^Really.","\n","^I’ll be quick.","\n","ev","str","^allowed_inside","/str",true,{"x()":"SetEventVar","exArgs":2},"pop","/ev","\n","ev",{"VAR?":"GraveyardProtection"},50,"-","/ev",{"VAR=":"GraveyardProtection","re":true},"end",{"#f":1}],"refused_early":["^Yeah.","\n","^That figures.","\n","^Nobody ever wants to deal with things before they rot.","\n","^They just lock the gate and walk away.","\n","^If this turns into a mess later, just remember I came by.","\n","ev","str","^allowed_inside","/str",false,{"x()":"SetEventVar","exArgs":2},"pop","/ev","\n","end",{"#f":1}],"final_refusal":["^…Alright.","\n","^I tried to handle this properly.","\n","^If this turns into a mess later, just remember I came by.","\n","ev","str","^allowed_inside","/str",false,{"x()":"SetEventVar","exArgs":2},"pop","/ev","\n","end",{"#f":1}],"global decl":["ev",0,{"VAR=":"player_mean"},0,{"VAR=":"player_scared"},0,{"VAR=":"player_stupid"},0,{"VAR=":"SpiritAngered"},0,{"VAR=":"GraveRobberSetup"},100,{"VAR=":"Sanity"},100,{"VAR=":"GraveyardProtection"},"/ev","end",null],"#f":1}],"listDefs":{}}