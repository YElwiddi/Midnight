{"inkVersion":21,"root":[[["done",{"#f":5,"#n":"g-0"}],null],"done",{"start":[["^Good evening.","\n","^I'm Father Joseph.","\n","^I used to be the pastor here at this church.","\n","^I need to come inside for a moment.","\n","ev","str","^Why?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^What is your business here?","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"why"},{"#f":5}],"c-1":["\n",{"->":"why"},{"#f":5}]}],{"#f":1}],"why":[["^Well...","\n","^I've left something important in the basement of that abandoned church years ago.","\n","^I need to come inside and reclaim it.","\n","ev","str","^What did you leave behind?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Why wait until now?","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"what_behind"},{"#f":5}],"c-1":["\n",{"->":"why_now"},{"#f":5}]}],{"#f":1}],"what_behind":[["^A wedding ring for my betrothed. It remained here after many years.","\n","^I need it back.","\n","ev","str","^Are you hiding something?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^You came all this way just for that?","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"hiding_something"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"player_mean"},1,"+",{"VAR=":"player_mean","re":true},"/ev",{"->":"buy_another"},{"#f":5}]}],{"#f":1}],"buy_another":[["^Yes. It has very large sentimental value to me.","\n","^I need to enter the grounds to retrieve it.","\n","ev","str","^You're hiding something.","/str","/ev",{"*":".^.c-0","flg":4},{"c-0":["\n",{"->":"hiding_something"},{"#f":5}]}],{"#f":1}],"hiding_something":["^Alright, I will be candid with you.","\n",{"->":"why_now"},{"#f":1}],"why_now":[["^I had hoped not to return to this place.","\n","^But recently... I have felt immense guilt over the loss of my wife to be.","\n","^She passed away before I had the opportunity to take our vows.","\n","^I must return to retrieve our wedding ring.","\n","^As something to remember her by.","\n","ev","str","^Are you lying?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^How can I trust you?","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"trust"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"player_scared"},1,"+",{"VAR=":"player_scared","re":true},"/ev",{"->":"hesitation"},{"#f":5}]}],{"#f":1}],"trust":["^No. I know it has been many years since I've returned to these grounds...","\n","^But I'm back now and I need to retrieve what is rightfully mine.","\n","^So please...","\n",{"->":"ask_for_entry"},{"#f":1}],"hesitation":["^You are wise to hesitate.","\n","^Every step toward that church feels like walking back into a memory that has been waiting patiently for my return.","\n","^But I need that ring.","\n","^I would like you to come with me to retrieve it.","\n",{"->":"ask_for_entry"},{"#f":1}],"ask_for_entry":[["^Shall we go together?","\n","ev","str","^Alright. Let's go.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^I'm sorry father, but you should leave.","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^I have more questions.","/str","/ev",{"*":".^.c-2","flg":4},"ev","str","^Hold on, I'll be right back.","/str","/ev",{"*":".^.c-3","flg":4},{"c-0":["\n",{"->":"allow_entry"},{"#f":5}],"c-1":["\n",{"->":"refusal_end_1"},{"#f":5}],"c-2":["\n",{"->":"more_questions"},{"#f":5}],"c-3":["\n","ev",{"x()":"SuspendDialogue"},"pop","/ev","\n",{"->":".^.^.^"},{"#f":5}]}],{"#f":1}],"more_questions":[["ev","str","^What was your name again?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Do you have any family members?","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^Nevermind.","/str","/ev",{"*":".^.c-2","flg":4},{"c-0":["\n",{"->":"ask_name_again"},{"#f":5}],"c-1":["\n",{"->":"how_many"},{"#f":5}],"c-2":["\n",{"->":"ask_for_entry"},{"#f":5}]}],{"#f":1}],"ask_name_again":["^My name is Father Joseph Smith.","\n",{"->":"more_questions"},{"#f":1}],"how_many":["^I have no immediate family members.","\n",{"->":"more_questions"},{"#f":1}],"allow_entry":["^Thank you.","\n","^We will not be long.","\n","^It is down the hall, on the staircase to the right.","\n","^I know the way.","\n","^...","\n","^I hope we are not too late.","\n","^Hurry.","\n","ev","str","^allowed_inside","/str",true,{"x()":"SetEventVar","exArgs":2},"pop","/ev","\n","end",{"#f":1}],"refusal_end_1":[["^...","\n","^I urge you to reconsider.","\n","^It is very important you allow me inside to retrieve the lost item.","\n","^Please. Allow me in.","\n","ev","str","^You're right. I'm sorry. Let's go inside.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^No. Leave.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"allow_entry"},{"#f":5}],"c-1":["\n",{"->":"refusal_end_2"},{"#f":5}]}],{"#f":1}],"refusal_end_2":["^Very well.","\n","^I will not force your hand.","\n","^May God forgive us both.","\n","ev","str","^allowed_inside","/str",false,{"x()":"SetEventVar","exArgs":2},"pop","/ev","\n","end",{"#f":1}],"global decl":["ev",0,{"VAR=":"player_mean"},0,{"VAR=":"player_scared"},0,{"VAR=":"player_stupid"},0,{"VAR=":"SpiritAngered"},0,{"VAR=":"GraveRobberSetup"},100,{"VAR=":"Sanity"},100,{"VAR=":"GraveyardProtection"},"/ev","end",null],"#f":1}],"listDefs":{}}