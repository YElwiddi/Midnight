  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: af6c11f0d531f4249801ea5c2de41bcb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableTrigger
  interactionPrompt: Read
  backgroundImage: {fileID: 21300000, guid: 5face2da520a6fa4fa8eff1c614aff70, type: 3}
  fontOverride: {fileID: 11400000, guid: e4cf2c21c93fda745b09b91b791a22c2, type: 2}
  overrideAlignment: 0
  textAlignment: 257
  overrideMargins: 0
  textMargins: {x: 0, y: 0, z: 0, w: 0}
  overrideLineSpacing: 0
  lineSpacing: 0
  overrideFontSize: 1
  fontSize: 18
  overrideFontColor: 1
  fontColor: {r: 0, g: 0, b: 0, a: 1}
  pages:
  - "Excerpt from the Gravekeeper\u2019s Notes\nAdams family\n\nFamily members:\nEdwin
    Adams, 21, Alive\nJane Adams, 54, Deceased\nRebecca Adams, 48, Alive\n\nJane
    Adams is interred within these grounds.\n\nCause of death: Suicide\n\nTime of
    death: December 22, 1993, Friday 3:21 AM"
  - "Jane Adams rests here after a life defined by order and restraint. She worked
    for many years as a bookkeeper at the municipal works office, kept her home immaculate,
    and raised her son, Edwin, with strict routines and clear expectations. When
    Edwin was seven, she sent him to live with close family friends out of state,
    telling neighbors it was for better schooling. After his departure, Jane\u2019s
    attendance at work faltered, and she resigned quietly.\n\nJane took her own life
    weeks later. The gravekeeper notes that Edwin was never informed of her death,
    and those responsible agreed it was best he not be recalled or told the circumstances.
    The consequences of her actions, and the disgrace they carried, were more than
    she was willing to answer for in the open. She ended her life in solitude, ensuring
    that her son\u2019s memory of her would remain unburdened by the truth she could
    not endure."
  enableLowSanityOverride: 0
  lowSanityThreshold: 0.25
  lowSanityOverrides:
    overridePages: 0
    pages: []
