  m_Script: {fileID: 11500000, guid: af6c11f0d531f4249801ea5c2de41bcb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableTrigger
  interactionPrompt: Read
  backgroundImage: {fileID: 21300000, guid: 5face2da520a6fa4fa8eff1c614aff70, type: 3}
  fontOverride: {fileID: 11400000, guid: e4cf2c21c93fda745b09b91b791a22c2, type: 2}
  overrideAlignment: 0
  textAlignment: 272
  overrideMargins: 0
  textMargins: {x: 0, y: 0, z: 0, w: 0}
  overrideLineSpacing: 0
  lineSpacing: 0
  overrideFontSize: 1
  fontSize: 18
  overrideFontColor: 1
  fontColor: {r: 0, g: 0, b: 0, a: 1}
  pages:
  - "Excerpt from the Gravekeeper\u2019s Notes\nVanderbilt family\n\nFamily members:\nAaron
    Vanderbilt, 69, Deceased\nHarold Vanderbilt, 42, Unknown\nErick Vanderbilt, 22,
    Alive\n\nAaron Vanderbilt is interred within these grounds.\n\nCause of death:
    Gunshot wound\n\nTime of death: June 27, 1993, Thursday 7:48 PM"
  - "Aaron Vanderbilt is remembered here as a man whose life carried the weight of
    absence and missteps. His brother disappeared many years ago under circumstances
    no one could trace, leaving Aaron to navigate the world alone. Though capable
    and clever, he found himself drawn into circles that promised opportunity but
    delivered danger, aligning with people whose loyalties were fleeting and whose
    intentions were rarely honest.\n\nThose who knew him speak of quiet struggles
    hidden behind a confident exterior. Aaron\u2019s dealings with the wrong company
    shaped much of his later years, leaving him isolated and wary. The fate of his
    brother remains a lingering shadow over his life, a reminder of paths lost and
    choices that carry consequences beyond one\u2019s control.\n\nAaron Vanderbilt
    rests here alone. "
  enableLowSanityOverride: 0
  lowSanityThreshold: 0.25
