  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: af6c11f0d531f4249801ea5c2de41bcb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableTrigger
  interactionPrompt: Read
  backgroundImage: {fileID: 21300000, guid: 5face2da520a6fa4fa8eff1c614aff70, type: 3}
  fontOverride: {fileID: 11400000, guid: e4cf2c21c93fda745b09b91b791a22c2, type: 2}
  overrideAlignment: 0
  textAlignment: 257
  overrideMargins: 0
  textMargins: {x: 0, y: 0, z: 0, w: 0}
  overrideLineSpacing: 0
  lineSpacing: 0
  overrideFontSize: 1
  fontSize: 18
  overrideFontColor: 1
  fontColor: {r: 0, g: 0, b: 0, a: 1}
  pages:
  - "Excerpt from the Gravekeeper\u2019s Notes\nHolmes family\n\n\nFamily members:\nJason
    Holmes, 48, Alive\nZackary Holmes, 46, Deceased\nEdward Holmes, 17, Deceased\nElisabeth
    Holmes, 45, Alive\n\nEdward and Zackary are interred within these grounds.\n\nCause
    of death: Unknown; alleged accident\n\nTime of death: April 12, 1998, Monday
    3:45 AM"
  - 'Zackary and Edward Holmes were laid to rest here following an accident reported
    along the county road. Official accounts describe a single-vehicle collision,
    the car discovered overturned beyond the tree line, engine still warm when authorities
    arrived. Elisabeth was found nearby in a state of shock and later released without
    charge. The surviving family declined further inquiry, and the matter was recorded
    as misfortune rather than malice.


    In the weeks prior, neighbors noted unusual
    hours kept within the Holmes residence and the steady removal of furnishings
    from the basement to an unseen location. Parish records show Zackary and Edward
    had not attended services for some time, though candles and ash were later found
    among their personal effects. The gravekeeper records that the vehicle showed
    little damage consistent with the severity described, and that Elisabeth never
    returned to these grounds after the burial. What occurred before 3:45 that morning
    remains officially unexamined, though the silence maintained by the living suggests
    a conclusion reached long before the report was written.'
  enableLowSanityOverride: 1
  lowSanityThreshold: 0.25
  lowSanityOverrides:
    overridePages: 1
    pages:
    - HE IS A LYING BASTARD DO NOT TRUST HIM
    overrideBackground: 0
    backgroundImage: {fileID: 0}
    fontOverride: {fileID: 11400000, guid: cd1cf9cc035cb5d40aab14e7348c5722, type: 2}
    overrideAlignment: 0
    textAlignment: 257
    overrideMargins: 0
    textMargins: {x: 0, y: 0, z: 0, w: 0}
    overrideLineSpacing: 0
    lineSpacing: 0
    overrideFontSize: 1
    fontSize: 48
    overrideFontColor: 1
    fontColor: {r: 0.8018868, g: 0, b: 0, a: 1}
    enableShake: 1
    shakeIntensity: 3
    shakeSpeed: 25
