  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: af6c11f0d531f4249801ea5c2de41bcb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableTrigger
  interactionPrompt: Read
  backgroundImage: {fileID: 21300000, guid: 5face2da520a6fa4fa8eff1c614aff70, type: 3}
  fontOverride: {fileID: 11400000, guid: e4cf2c21c93fda745b09b91b791a22c2, type: 2}
  overrideAlignment: 0
  textAlignment: 257
  overrideMargins: 0
  textMargins: {x: 0, y: 0, z: 0, w: 0}
  overrideLineSpacing: 0
  lineSpacing: 0
  overrideFontSize: 1
  fontSize: 18
  overrideFontColor: 1
  fontColor: {r: 0, g: 0, b: 0, a: 1}
  pages:
  - "Excerpt from the Gravekeeper\u2019s Notes\nAnderson family\n\n\nFamily members:\nAnthony
    Anderson, 41, Deceased\nDiane Anderson, 39, Deceased\nJames Anderson, 9, Deceased\nDerek
    Anderson, 10, Deceased\nLily Anderson, 6, Alive\n\nAnthony is interred within
    these grounds.\n\nCause of death: Burned to death in house fire\n\nTime of death:
    October 11, 1988, Saturday 12:03 AM"
  - 'Anthony Anderson, his wife Diane, and their two sons were recovered from their
    home following a fire reported shortly after midnight. The blaze was attributed
    to an electrical malfunction near the rear stairwell, where damage was most concentrated.
    The victims were found together in an upstairs bedroom, smoke inhalation listed
    as the cause of death. One child survived, having exited the house before responders
    arrived, and was later placed into foster care. The official record notes no
    evidence of forced entry or outside involvement.


    Neighbors recalled the
    family had kept irregular hours in the weeks preceding the fire and had gradually
    removed items from the upper rooms, though no reason was given. Utility inspections
    showed no prior faults, and the surviving child declined to describe events before
    the flames were visible, stating only that her father instructed them to remain
    together. A lighter was cataloged among the debris near the stairwell, dismissed
    as incidental due to fire damage. The matter was closed as accidental loss, and
    no further inquiry was pursued.'
  enableLowSanityOverride: 0
  lowSanityThreshold: 0.25
  lowSanityOverrides:
    overridePages: 0
    pages: []
    overrideBackground: 0
    backgroundImage: {fileID: 0}
    fontOverride: {fileID: 0}
