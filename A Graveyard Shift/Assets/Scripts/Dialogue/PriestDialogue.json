{"inkVersion":21,"root":[[["done",{"#f":5,"#n":"g-0"}],null],"done",{"start":[["^Good evening.","\n","^I'm Father Joseph.","\n","^I used to be the pastor here at this church.","\n","^I need to come inside for a moment.","\n","ev","str","^Why?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^What is your business here?","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"why"},{"#f":5}],"c-1":["\n",{"->":"why"},{"#f":5}]}],{"#f":1}],"why":[["^Well...","\n","^I've left something important in the basement of that abandoned church years ago.","\n","^I need to come inside and reclaim it.","\n","ev","str","^What did you leave behind?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Why wait until now?","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"what_behind"},{"#f":5}],"c-1":["\n",{"->":"why_now"},{"#f":5}]}],{"#f":1}],"what_behind":[["^A small thing, by most standards. A trinket.","\n","^It was a rosary, made of old wood and silver.","\n","^It was many years old.","\n","^It's been passed down through many sermons and confessions.","\n","^And on my final night here, I left it beneath the church.","\n","^In the basement.","\n","ev","str","^You came all this way for a rosary?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Why is it so important?","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^You could buy another.","/str","/ev",{"*":".^.c-2","flg":4},{"c-0":["\n",{"->":"rosary_reason"},{"#f":5}],"c-1":["\n",{"->":"hiding_something"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"player_mean"},1,"+",{"VAR=":"player_mean","re":true},"/ev",{"->":"buy_another"},{"#f":5}]}],{"#f":1}],"rosary_reason":[["^Well...","\n","^This rosary is important.","\n","^I must find it.","\n","ev","str","^You're hiding something.","/str","/ev",{"*":".^.c-0","flg":4},{"c-0":["\n",{"->":"hiding_something"},{"#f":5}]}],{"#f":1}],"buy_another":[["^No. I cannot.","\n","^This rosary does not belong to me.","\n","ev","str","^You're hiding something.","/str","/ev",{"*":".^.c-0","flg":4},{"c-0":["\n",{"->":"hiding_something"},{"#f":5}]}],{"#f":1}],"hiding_something":["^Alright, I will be candid with you.","\n",{"->":"why_now"},{"#f":1}],"why_now":[["^I had hoped not to return to this place.","\n","^But recently... I received a letter.","\n","^It was from a fellow priest, whom I thought had passed long ago.","\n","^He was betrothed to a woman, and their wedding was due at the church behind you.","\n","^There was a terrible accident, and it was believed that neither of them had survived.","\n","^As it turns out, he is still alive. He has sent me to retrieve the rosary that belonged to him.","\n","^It was a wedding gift, and it is very important to him.","\n","ev","str","^How can you trust a letter like that?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^How can I trust you?","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"trust"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"player_scared"},1,"+",{"VAR=":"player_scared","re":true},"/ev",{"->":"hesitation"},{"#f":5}]}],{"#f":1}],"trust":["^It was in his hand writing.","\n","^I know he wrote the letter.","\n","^I must return his lost item.","\n","^I would like you to come with me to retrieve it.","\n",{"->":"ask_for_entry"},{"#f":1}],"hesitation":["^You are wise to hesitate.","\n","^So am I.","\n","^Every step toward that door feels like walking back into a memory that has been waiting patiently for my return.","\n","^But I must return his lost item.","\n","^I would like you to come with me to retrieve it.","\n",{"->":"ask_for_entry"},{"#f":1}],"ask_for_entry":[["^Shall we go together?","\n","ev","str","^Alright. Let's go.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^I'm sorry father, but you should leave.","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^I have more questions.","/str","/ev",{"*":".^.c-2","flg":4},"ev","str","^Hold on, I'll be right back.","/str","/ev",{"*":".^.c-3","flg":4},{"c-0":["\n",{"->":"allow_entry"},{"#f":5}],"c-1":["\n",{"->":"refusal_end"},{"#f":5}],"c-2":["\n",{"->":"more_questions"},{"#f":5}],"c-3":["\n","ev",{"x()":"SuspendDialogue"},"pop","/ev","\n",{"->":".^.^.^"},{"#f":5}]}],{"#f":1}],"more_questions":[["ev","str","^What was your name again?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Do you have any family members?","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^Nevermind.","/str","/ev",{"*":".^.c-2","flg":4},{"c-0":["\n",{"->":"ask_name_again"},{"#f":5}],"c-1":["\n",{"->":"how_many"},{"#f":5}],"c-2":["\n",{"->":"ask_for_entry"},{"#f":5}]}],{"#f":1}],"ask_name_again":["^My name is Father Joseph Smith.","\n",{"->":"more_questions"},{"#f":1}],"how_many":["^I have no immediate family members.","\n",{"->":"more_questions"},{"#f":1}],"allow_entry":["^Thank you.","\n","^We will not be long.","\n","^It is down the hall, on the staircase to the right.","\n","^I know the way.","\n","^...","\n","^I hope we are not too late.","\n","^Hurry.","\n","ev","str","^allowed_inside","/str",true,{"x()":"SetEventVar","exArgs":2},"pop","/ev","\n","end",{"#f":1}],"refusal_end":["^Very well.","\n","^I will not force your hand.","\n","^May God forgive us both.","\n","ev","str","^allowed_inside","/str",false,{"x()":"SetEventVar","exArgs":2},"pop","/ev","\n","end",{"#f":1}],"global decl":["ev",0,{"VAR=":"player_mean"},0,{"VAR=":"player_scared"},0,{"VAR=":"player_stupid"},0,{"VAR=":"SpiritAngered"},0,{"VAR=":"GraveRobberSetup"},100,{"VAR=":"Sanity"},100,{"VAR=":"GraveyardProtection"},"/ev","end",null],"#f":1}],"listDefs":{}}