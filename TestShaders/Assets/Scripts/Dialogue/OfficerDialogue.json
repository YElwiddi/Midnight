{"inkVersion":21,"root":[[["done",{"#f":5,"#n":"g-0"}],null],"done",{"start":[["^Evening.","\n","^My name is officer James. I'm here with my partner, officer Baidey on an investigation.","\n","^We've heard reports of some disturbances coming from both from this cemetery and the surrounding neighborhood.","\n","^Apparently some folks saw some strange gang behavior. We took the call, and that's why we're here.","\n","^Would you mind answering some questions for us?","\n","ev","str","^Alright, how can I help you?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Sorry, I can't help you.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","ev",{"VAR?":"player_scared"},1,"+","/ev",{"VAR=":"player_scared","re":true},{"->":"interrogation_accept"},{"#f":5}],"c-1":["\n",{"->":"interrogation_decline"},{"#f":5}]}],{"#f":1}],"interrogation_accept":[["^Great, so we've received reports of a few men breaking and entering into homes around this neighborhood.","\n","^Apparently, some of them have been sighted near this cemetary as well.","\n","^I'd like your help in conducting this investigation.","\n","^Firstly, have you seen anyone attempting to enter the premises dressed in black?","\n","ev","str","^No, officer.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Yes, I have.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"next_question"},{"#f":5}],"c-1":["\n",{"->":"interrogate_entry"},{"#f":5}]}],{"#f":1}],"interrogate_entry":[["^Could you describe the behavior of this individiual?","\n","ev","str","^They asked to come in and see a grave.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^They never approached me.","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^I don't remember.","/str","/ev",{"*":".^.c-2","flg":4},{"c-0":["\n","ev",{"VAR?":"GraveyardProtection"},5,"+","/ev",{"VAR=":"GraveyardProtection","re":true},{"->":"next_question"},{"#f":5}],"c-1":["\n",{"->":"next_question"},{"#f":5}],"c-2":["\n",{"->":"next_question"},{"#f":5}]}],{"#f":1}],"next_question":[["^Alright, I'll move on to my next question.","\n","^Have you seen anyone stalking the perimeter of this facility? Either by the walls, or the gate, looking in?","\n","ev","str","^Yes.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^No.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"describe_stalker"},{"#f":5}],"c-1":["\n",{"->":"ask_for_entry"},{"#f":5}]}],{"#f":1}],"describe_stalker":[["^Do you remember anything about this individual?","\n","^Perhaps the color of his clothes or complexion?","\n","ev","str","^They wearing a greenish brown shirt.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^They were wearing a grey robe.","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^I don't remember.","/str","/ev",{"*":".^.c-2","flg":4},{"c-0":["\n","ev",{"VAR?":"GraveyardProtection"},10,"+","/ev",{"VAR=":"GraveyardProtection","re":true},{"->":"ask_for_entry"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"Sanity"},10,"-","/ev",{"VAR=":"Sanity","re":true},{"->":"ask_for_entry"},{"#f":5}],"c-2":["\n",{"->":"ask_for_entry"},{"#f":5}]}],{"#f":1}],"ask_for_entry":["^Alright, we appreciate your coopearation.","\n","^We have one more question.","\n","^If it's alright with you...","\n",{"->":"ask"},{"#f":1}],"ask":[["^I would like to come inside and take a look around.","\n","ev","str","^Alright, go ahead.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^I'm afraid I can't let you in sir.","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^What did you say your name was again?","/str","/ev",{"*":".^.c-2","flg":4},"ev","str","^Hold on, I'll be right back.","/str","/ev",{"*":".^.c-3","flg":4},{"c-0":["\n","ev",{"VAR?":"GraveyardProtection"},35,"+","/ev",{"VAR=":"GraveyardProtection","re":true},"ev",{"VAR?":"Sanity"},30,"-","/ev",{"VAR=":"Sanity","re":true},"ev","str","^allowed_inside","/str",true,{"x()":"SetEventVar","exArgs":2},"pop","/ev","\n","end",{"#f":5}],"c-1":["\n",{"->":"decline"},"ev","str","^allowed_inside","/str",false,{"x()":"SetEventVar","exArgs":2},"pop","/ev","\n",{"#f":5}],"c-2":["\n",{"->":"ask_name_again"},{"#f":5}],"c-3":["\n","ev",{"x()":"SuspendDialogue"},"pop","/ev","\n",{"->":"ask"},{"#f":5}]}],{"#f":1}],"ask_name_again":["^My name is officer James.","\n",{"->":"ask"},{"#f":1}],"interrogation_decline":["^I see...","\n",{"->":"ask"},{"#f":1}],"decline":["ev","str","^allowed_inside","/str",false,{"x()":"SetEventVar","exArgs":2},"pop","/ev","\n","^Well, we don't have a warrant, so I can't force you to let me in.","\n","^We'll be nearby if there's any trouble. Keep an eye out.","\n","end",{"#f":1}],"global decl":["ev",0,{"VAR=":"player_mean"},0,{"VAR=":"player_scared"},0,{"VAR=":"player_stupid"},0,{"VAR=":"SpiritAngered"},0,{"VAR=":"GraveRobberSetup"},100,{"VAR=":"GraveyardProtection"},100,{"VAR=":"Sanity"},"/ev","end",null],"#f":1}],"listDefs":{}}