{"inkVersion":21,"root":[[["done",{"#f":5,"#n":"g-0"}],null],"done",{"start":[["^Oh.","\n","^Um.","\n","^I think I'm okay now.","\n","^I stayed longer than I meant to.","\n","^It feels quieter in here.","\n","^Not good quiet.","\n","^Just... tired quiet.","\n","^I should probably go home.","\n","ev","str","^Did you find what you were looking for?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^You sure you’re alright to leave alone?","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"found_closure"},{"#f":5}],"c-1":["\n",{"->":"leaving_alone"},{"#f":5}]}],{"#f":1}],"found_closure":[["^I think so.","\n","^I talked for a bit.","\n","^Well.","\n","^I talked and nothing answered.","\n","^Which is how it's supposed to go.","\n","^So that's good.","\n","^I don't feel followed anymore.","\n","^Or maybe I just stopped checking.","\n","^That helps sometimes.","\n","ev","str","^Take care.","/str","/ev",{"*":".^.c-0","flg":4},{"c-0":["\n",{"->":"goodbye"},{"#f":5}]}],{"#f":1}],"leaving_alone":[["^Y-yeah.","\n","^I mean.","\n","^I walked here by myself.","\n","^And nothing bad happened.","\n","^Probably.","\n","^So it should be fine going back.","\n","^If I walk fast.","\n","^But not run.","\n","^Running makes it obvious you're scared.","\n","ev",{"VAR?":"player_stupid"},1,"+","/ev",{"VAR=":"player_stupid","re":true},"ev","str","^Goodnight.","/str","/ev",{"*":".^.c-0","flg":4},{"c-0":["\n",{"->":"goodbye"},{"#f":5}]}],{"#f":1}],"goodbye":["^Okay.","\n","^Thank you.","\n","^For letting me in.","\n","^And for not laughing.","\n","^I'll be gone in just a second.","\n","^If you hear footsteps after I leave—","\n","^They're probably mine.","\n","end",{"#f":1}],"global decl":["ev",0,{"VAR=":"player_mean"},0,{"VAR=":"player_scared"},0,{"VAR=":"player_stupid"},0,{"VAR=":"SpiritAngered"},0,{"VAR=":"GraveRobberSetup"},"/ev","end",null],"#f":1}],"listDefs":{}}