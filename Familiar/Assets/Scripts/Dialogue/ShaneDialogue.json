{"inkVersion":21,"root":[[["done",{"#f":5,"#n":"g-0"}],null],"done",{"start":[["^Hey.","\n","^Didn't think anyone would be out here this late.","\n","^You work this place?","\n","^Listen… I don’t wanna make trouble.","\n","^I just need a minute inside.","\n","ev","str","^Who are you?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^It's late. What do you want?","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"who_are_you"},{"#f":5}],"c-1":["\n",{"->":"what_do_you_want"},{"#f":5}]}],{"#f":1}],"who_are_you":[["^My name's Shane.","\n","^Deloitte family. We live a ways down the road.","\n","^I’m not here to steal anything or mess around.","\n","^There’s something in there that belongs to my family.","\n","^Something that never got handled right.","\n","ev","str","^Handled how?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Rules are rules. I can’t let you in.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"handled_how"},{"#f":5}],"c-1":["\n",{"->":"refused_early"},{"#f":5}]}],{"#f":1}],"what_do_you_want":[["^I just need to see a grave.","\n","^It's unmarked.","\n","^Most folks don’t even know it’s there.","\n","^I wouldn’t be here if I had another option.","\n","ev","str","^Why is it unmarked?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^That doesn’t matter. You need to leave.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"why_unmarked"},{"#f":5}],"c-1":["\n",{"->":"refused_early"},{"#f":5}]}],{"#f":1}],"handled_how":[["^They buried them in a hurry.","\n","^Didn’t ask questions. Didn’t put a name down.","\n","^Just wanted it done and forgotten.","\n","^That kind of thing sticks with a family.","\n","^Sticks with a place too.","\n","ev","str","^You’re talking in circles. Be straight with me.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^I’m sorry, but I still can’t let you in.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"be_straight"},{"#f":5}],"c-1":["\n",{"->":"refused_early"},{"#f":5}]}],{"#f":1}],"why_unmarked":[["^Because it was easier that way.","\n","^No paperwork. No attention.","\n","^Just dirt over a problem.","\n","^I know how this sounds.","\n","^But I need to see it with my own eyes.","\n","^Make sure nothing’s… wrong.","\n","ev","str","^What could be wrong?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^No. You’re not going inside.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"whats_wrong"},{"#f":5}],"c-1":["\n",{"->":"refused_early"},{"#f":5}]}],{"#f":1}],"be_straight":[["^…Alright.","\n","^Something’s been off lately.","\n","^Bad dreams. Whispers.","\n","^Like something’s calling out and not getting an answer.","\n","^I just wanna make sure it’s quiet.","\n","^That it stays that way.","\n","ev","str","^Fine. You can go in, but be quick.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Absolutely not. You’re done here.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"let_in"},{"#f":5}],"c-1":["\n",{"->":"final_refusal"},{"#f":5}]}],{"#f":1}],"whats_wrong":[["^Graves aren’t supposed to feel warm.","\n","^They aren’t supposed to feel awake.","\n","^I don’t want to find out what happens if it’s ignored.","\n","^Not again.","\n","ev","str","^Okay. One minute. Then you leave.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^This is crossing a line. Go.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"let_in"},{"#f":5}],"c-1":["\n",{"->":"final_refusal"},{"#f":5}]}],{"#f":1}],"let_in":["^Thank you.","\n","^Really.","\n","^I’ll be quick.","\n","^And whatever happens after tonight…","\n","^That’s on me.","\n","ev","str","^allowed_inside","/str",true,{"x()":"SetEventVar","exArgs":2},"pop","/ev","\n","ev",{"VAR?":"GraveRobberSetup"},1,"+","/ev",{"VAR=":"GraveRobberSetup","re":true},"end",{"#f":1}],"refused_early":["^Yeah.","\n","^That figures.","\n","^Nobody ever wants to deal with things before they rot.","\n","^They just lock the gate and walk away.","\n","^You have a good night.","\n","^If it lets you.","\n","ev","str","^allowed_inside","/str",false,{"x()":"SetEventVar","exArgs":2},"pop","/ev","\n","ev",{"VAR?":"SpiritAngered"},1,"+","/ev",{"VAR=":"SpiritAngered","re":true},"end",{"#f":1}],"final_refusal":["^…Alright.","\n","^I tried doing this the right way.","\n","^If something doesn’t stay buried tonight, don’t say you weren’t warned.","\n","ev","str","^allowed_inside","/str",false,{"x()":"SetEventVar","exArgs":2},"pop","/ev","\n","ev",{"VAR?":"SpiritAngered"},1,"+","/ev",{"VAR=":"SpiritAngered","re":true},"end",{"#f":1}],"global decl":["ev",0,{"VAR=":"player_mean"},0,{"VAR=":"player_scared"},0,{"VAR=":"player_stupid"},0,{"VAR=":"SpiritAngered"},0,{"VAR=":"GraveRobberSetup"},"/ev","end",null],"#f":1}],"listDefs":{}}